# Postgres connection (Supabase: Project Settings -> Database -> Connection string)
# Pooled connection (port 6543, add ?pgbouncer=true) for the app:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) for migrations:
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Password Josephine uses to log in to /admin
ADMIN_PASSWORD="choose-a-strong-password"
# Any long random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET="long-random-string"

# Public address of the shop, used for links, sitemap and Google
NEXT_PUBLIC_SITE_URL="https://josephinecosmetics.com"

# Push notifications for new orders (Josephine's iPhone). Generate once with:
#   npx web-push generate-vapid-keys
# Leave empty to switch notifications off.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
